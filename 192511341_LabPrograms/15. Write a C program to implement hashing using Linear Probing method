#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

void insert(int key) {
    int index, i;

    index = key % SIZE;

    for (i = 0; i < SIZE; i++) {
        if (hashTable[index] == -1) {
            hashTable[index] = key;
            return;
        }

        index = (index + 1) % SIZE;
    }

    printf("Hash table is full\n");
}

void display() {
    int i;

    for (i = 0; i < SIZE; i++) {
        if (hashTable[i] == -1)
            printf("%d : Empty\n", i);
        else
            printf("%d : %d\n", i, hashTable[i]);
    }
}

int main() {
    int n, key, i;

    for (i = 0; i < SIZE; i++)
        hashTable[i] = -1;

    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        scanf("%d", &key);
        insert(key);
    }

    display();

    return 0;
}
