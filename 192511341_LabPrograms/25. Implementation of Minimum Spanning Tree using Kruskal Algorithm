#include <stdio.h>

struct Edge {
    int u, v, weight;
};

int parent[100];

int find(int x) {
    if (parent[x] == x)
        return x;

    return find(parent[x]);
}

void unionSet(int a, int b) {
    parent[find(a)] = find(b);
}

int main() {
    struct Edge edges[100], temp;
    int n, e, i, j;
    int count = 0, total = 0;

    scanf("%d %d", &n, &e);

    for (i = 0; i < e; i++)
        scanf("%d %d %d", &edges[i].u, &edges[i].v, &edges[i].weight);

    for (i = 0; i < n; i++)
        parent[i] = i;

    for (i = 0; i < e - 1; i++) {
        for (j = 0; j < e - i - 1; j++) {
            if (edges[j].weight > edges[j + 1].weight) {
                temp = edges[j];
                edges[j] = edges[j + 1];
                edges[j + 1] = temp;
            }
        }
    }

    for (i = 0; i < e && count < n - 1; i++) {
        if (find(edges[i].u) != find(edges[i].v)) {
            printf("%d - %d : %d\n",
                   edges[i].u,
                   edges[i].v,
                   edges[i].weight);

            total += edges[i].weight;
            unionSet(edges[i].u, edges[i].v);
            count++;
        }
    }

    printf("Minimum Cost = %d", total);

    return 0;
}
