#include <stdio.h>

int main() {
    int graph[20][20], visited[20] = {0};
    int queue[20], front = 0, rear = 0;
    int n, start, i, v;

    scanf("%d", &n);

    for (i = 0; i < n; i++)
        for (v = 0; v < n; v++)
            scanf("%d", &graph[i][v]);

    scanf("%d", &start);

    queue[rear++] = start;
    visited[start] = 1;

    while (front < rear) {
        int current = queue[front++];

        printf("%d ", current);

        for (i = 0; i < n; i++) {
            if (graph[current][i] == 1 && !visited[i]) {
                visited[i] = 1;
                queue[rear++] = i;
            }
        }
    }

    return 0;
}
