#include <stdio.h>

int main() {
    int a[100], n, choice, pos, value, i;

    scanf("%d", &n);

    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    while (1) {
        scanf("%d", &choice);

        if (choice == 1) {
            scanf("%d %d", &pos, &value);

            for (i = n; i >= pos; i--)
                a[i] = a[i - 1];

            a[pos - 1] = value;
            n++;
        }
        else if (choice == 2) {
            scanf("%d", &pos);

            for (i = pos - 1; i < n - 1; i++)
                a[i] = a[i + 1];

            n--;
        }
        else if (choice == 3) {
            for (i = 0; i < n; i++)
                printf("%d ", a[i]);

            printf("\n");
        }
        else if (choice == 4) {
            break;
        }
    }

    return 0;
}
