#include <stdio.h>

#define INF 9999

int main() {
    int graph[20][20], distance[20], visited[20];
    int n, source, i, j, count, min, next;

    scanf("%d", &n);

    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    scanf("%d", &source);

    for (i = 0; i < n; i++) {
        distance[i] = graph[source][i];
        visited[i] = 0;
    }

    distance[source] = 0;
    visited[source] = 1;

    for (count = 1; count < n; count++) {
        min = INF;
        next = -1;

        for (i = 0; i < n; i++) {
            if (!visited[i] && distance[i] < min) {
                min = distance[i];
                next = i;
            }
        }

        if (next == -1)
            break;

        visited[next] = 1;

        for (i = 0; i < n; i++) {
            if (!visited[i] && graph[next][i] != 0 &&
                distance[next] + graph[next][i] < distance[i]) {
                distance[i] = distance[next] + graph[next][i];
            }
        }
    }

    for (i = 0; i < n; i++)
        printf("Vertex %d : %d\n", i, distance[i]);

    return 0;
}
